[
  {
    "label": "cargo build (debug)",
    "command": "cargo",
    "args": ["build"],
    "cwd": "$ZED_WORKTREE_ROOT/Rust/the_salmon_river"
  },
  {
    "label": "cargo build (release)",
    "command": "cargo",
    "args": ["build", "--release"],
    "cwd": "$ZED_WORKTREE_ROOT/Rust/the_salmon_river"
  },
  {
    "label": "cargo check",
    "command": "cargo",
    "args": ["check"],
    "cwd": "$ZED_WORKTREE_ROOT/Rust/the_salmon_river"
  },
  {
    "label": "cargo clippy",
    "command": "cargo",
    "args": ["clippy", "--", "-D", "warnings"],
    "cwd": "$ZED_WORKTREE_ROOT/Rust/the_salmon_river"
  }
]
